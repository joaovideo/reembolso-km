# Copie para .env e preencha. O .env nunca vai para o git.
GOOGLE_MAPS_API_KEY=COLE_AQUI_A_CHAVE
PORT=3080
# Colaboradores iniciais (depois, gerencie em Configurações)
# COLABORADORES=Ana,Bruno,Carla
# Caminho do banco SQLite (padrão: data/reembolso.sqlite)
# DB_PATH=data/reembolso.sqlite
# Senha de acesso (Basic Auth). Sem as duas, o app fica aberto (só para uso local).
# APP_USER=equipe
# APP_PASS=troque-esta-senha
# IPs de proxies confiáveis (HAProxy) para registrar o IP real do cliente, separados por vírgula
# TRUSTED_PROXIES=10.0.0.1
